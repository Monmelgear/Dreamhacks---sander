<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Island Trade Architect: Sustainable Paths</title>
<style>
  /* =========================================
     CUSTOM SCROLLBARS (Matches Game Theme)
     ========================================= */
  * { 
    box-sizing: border-box; 
    /* Firefox */
    scrollbar-width: thin;
    scrollbar-color: #4a3b32 #151211;
  }

  /* WebKit (Chrome, Safari, Edge) */
  ::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }
  ::-webkit-scrollbar-track {
    background: #151211;
    border-left: 1px solid #2a2421;
  }
  ::-webkit-scrollbar-thumb {
    background: #4a3b32;
    border-radius: 6px;
    border: 2px solid #151211; /* Creates a slight padding effect */
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #e6c875; /* Turns gold on hover */
  }

  /* =========================================
     MAIN LAYOUT STYLES
     ========================================= */
  body {
    margin: 0;
    padding: 10px;
    background-color: #12100e;
    color: #fff;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow-x: hidden;
    overflow-y: auto; /* Allows full-site scrolling */
  }
  h1 { margin: 0 0 4px 0; color: #e6c875; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); font-size: 24px; }
  #subtitle { font-size: 12px; color: #b7b0a8; max-width: 780px; text-align: center; margin-bottom: 8px; line-height: 1.4; }

  #a11y-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
  }
  #a11y-bar button {
    font-size: 11px;
    padding: 5px 10px;
    background: #362f2d;
    color: #ffd983;
    border: 1px solid #4a3b32;
  }
  #a11y-bar button[aria-pressed="true"] {
    background: #e6c875;
    color: #1a1a1a;
  }
  #instructions-toggle {
    background: #4a3b32 !important;
    border-color: #e6c875 !important;
  }
  #instructions-toggle:hover {
    background: #6b5644 !important;
  }

  #game-layout {
    display: flex;
    gap: 15px;
    max-width: 1200px;
  }

  canvas {
    border: 3px solid #4a3b32;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.8);
    background-color: #1d4361;
    cursor: default;
  }

  #ui-panel {
    width: 330px;
    background: #2a2421;
    border: 2px solid #4a3b32;
    border-radius: 8px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 600px;
    box-sizing: border-box;
    overflow-y: auto;
  }

  .stat-card {
    background: #362f2d;
    padding: 8px;
    border-radius: 5px;
    font-size: 12px;
    border: 1px solid #4a3b32;
  }
  .stat-card h3 { margin: 0 0 5px 0; color: #e6c875; font-size: 14px; }

  .game-param { display: flex; justify-content: space-between; margin-bottom: 2px;}
  .param-val { font-weight: bold; color: #ffd983;}
  .param-val.warn { color: #ff8080; }
  .param-val.good { color: #8ef29a; }

  .bar-track { background: #151211; border-radius: 3px; height: 8px; overflow: hidden; margin-top: 2px; border: 1px solid #4a3b32; }
  .bar-fill { height: 100%; transition: width 0.4s ease; }

  button {
    background: #e6c875;
    color: #1a1a1a;
    border: none;
    padding: 6px;
    font-weight: bold;
    border-radius: 4px;
    cursor: pointer;
    transition: 0.2s;
    font-size: 12px;
  }
  button:hover { background: #ffd983; }
  button:disabled { background: #555; color: #ccc; cursor: not-allowed; }
  button:focus-visible, select:focus-visible, input:focus-visible {
    outline: 3px solid #75c8ff;
    outline-offset: 2px;
  }

  .role-btn { flex: 1 1 45%; font-size: 11px; padding: 6px 4px; background: #4a3b32; color: #fff; border: 1px solid #6b5644; }
  .role-btn[aria-pressed="true"] { background: #75c8ff; color: #12100e; }

  #log {
    flex-grow: 1;
    background: #151211;
    border: 1px solid #4a3b32;
    border-radius: 4px;
    padding: 5px;
    font-size: 11px;
    overflow-y: auto;
    color: #ccc;
    line-height: 1.3;
    min-height: 80px;
  }

  .log-event { color: #e6c875; }
  .log-attack { color: #ff5555; font-weight: bold;}
  .log-trade { color: #75c8ff; }
  .log-eco { color: #8ef29a; }

  select, input {
    width: 100%;
    padding: 3px;
    margin-top: 2px;
    background: #151211;
    color: #fff;
    border: 1px solid #4a3b32;
    box-sizing: border-box;
    font-size: 11px;
  }

  .instructions {
    font-size: 11px;
    color: #aaa;
    margin-top: 4px;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* =========================================
     INSTRUCTIONS MODAL STYLES
     ========================================= */
  #instructions-modal {
    display: flex; /* Flex to center */
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(18, 16, 14, 0.9);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(4px);
  }
  .modal-content {
    background: #2a2421;
    border: 2px solid #e6c875;
    border-radius: 8px;
    padding: 25px;
    max-width: 650px;
    max-height: 85vh;
    overflow-y: auto;
    color: #fff;
    box-shadow: 0 10px 40px rgba(0,0,0,0.9);
  }
  .modal-content h2 { margin-top: 0; color: #e6c875; text-align: center; border-bottom: 1px solid #4a3b32; padding-bottom: 10px;}
  .modal-content h3 { color: #75c8ff; margin-bottom: 5px; font-size: 16px; margin-top: 20px;}
  .modal-content p { font-size: 14px; line-height: 1.5; color: #ccc;}
  .modal-content ul { padding-left: 20px; font-size: 14px; color: #ccc; line-height: 1.5;}
  .modal-content li { margin-bottom: 8px; }
  .close-modal-btn {
    background: #e6c875;
    color: #1a1a1a;
    padding: 12px 20px;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 20px;
    width: 100%;
    font-size: 16px;
    transition: 0.2s;
  }
  .close-modal-btn:hover { background: #fff; }

  /* High Contrast Mode */
  body.high-contrast { background: #000; }
  body.high-contrast #ui-panel, body.high-contrast .modal-content { background: #000; border-color: #fff; }
  body.high-contrast .stat-card { background: #000; border: 2px solid #fff; }
  body.high-contrast .stat-card h3 { color: #ffff00; }
  body.high-contrast .param-val { color: #00ffff; }
  body.high-contrast canvas { border-color: #fff; }
  body.high-contrast button { background: #ffff00; color: #000; border: 2px solid #fff; }
  body.high-contrast .role-btn[aria-pressed="true"] { background: #00ffff; }
  body.high-contrast #log { border-color: #fff; }
</style>
</head>
<body>

<!-- INSTRUCTIONS MODAL -->
<div id="instructions-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-content">
    <h2 id="modal-title">How to Play: Island Trade Architect</h2>
    <p>Welcome to the island. Your goal is to keep all four isolated settlements alive by managing their resources, protecting the environment, and fighting off external threats.</p>
    
    <h3>1. Resource Management</h3>
    <ul>
      <li>Each settlement specializes in one resource (<strong>Forests</strong> = Wood, <strong>Plains</strong> = Food, <strong>Rivers</strong> = Water, <strong>Crags</strong> = Minerals).</li>
      <li>Every settlement constantly consumes a mix of <em>all four</em> resources to survive.</li>
      <li>If a settlement runs out of any resource, their population will begin to starve and die. You lose if a settlement collapses.</li>
    </ul>

    <h3>2. Drawing Trade Routes</h3>
    <ul>
      <li>To prevent starvation, you must share resources. Use the <strong>Custom Trade Route</strong> panel to set up automated deliveries.</li>
      <li>Select a sender, a receiver, the resource to send, and the amount.</li>
      <li>Click <strong>"Draw Route Path"</strong>, then click on the map to place waypoints to guide your caravans around dangerous terrain. Click <strong>"Finish Path"</strong> when done.</li>
    </ul>

    <h3>3. Defenses & Threats</h3>
    <ul>
      <li><strong>Raiders & Wildlife:</strong> Aggressive animals and bandits will attack your settlements and intercept your trade caravans.</li>
      <li><strong>Invasive Species:</strong> Purple growths will randomly spawn. If they get too close to a settlement, they will destroy the local environment, cutting resource yields in half.</li>
      <li>Use the <strong>Clan Defenses</strong> panel to spend Wood and Minerals on fortifications. High defense reduces raid damage and gives you a higher chance to successfully <strong>Clear Nearby Invasives</strong>.</li>
    </ul>

    <h3>4. Choose Your Role</h3>
    <ul>
      <li>Select a role on the left panel (Diplomat, Ranger, Guardian, Merchant). Each provides passive bonuses to your playstyle.</li>
      <li>Once your cooldown finishes, you can trigger a powerful <strong>Unique Ability</strong> to bail you out of bad situations.</li>
    </ul>

    <button class="close-modal-btn" id="close-modal-btn">Got it, let's play!</button>
  </div>
</div>

<h1>Island Trade Architect: Sustainable Paths</h1>
<p id="subtitle">A simulation tool for exploring how isolated coastal settlements can build fair resource-sharing networks, hold off environmental and physical threats, and stay resilient without stripping the land bare.</p>

<div id="a11y-bar" role="group" aria-label="Accessibility settings">
  <button id="instructions-toggle" aria-expanded="false" aria-controls="instructions-modal">📖 How to Play</button>
  <button id="contrast-toggle" aria-pressed="false">🌓 High Contrast</button>
  <button id="motion-toggle" aria-pressed="false">🐢 Reduce Motion</button>
</div>

<div id="game-layout">
  <canvas id="gameCanvas" width="800" height="600" role="img" aria-label="Island map showing four distinct habitats."></canvas>

  <div id="ui-panel">
    <div class="stat-card" id="role-card">
      <h3>Your Role</h3>
      <div class="instructions" id="role-desc">Choose a role for passive bonuses and a unique ability.</div>
      <div style="display:flex; flex-wrap:wrap; gap:4px; margin-top:6px;" role="group" aria-label="Choose your role">
        <button type="button" class="role-btn" data-role="diplomat" aria-pressed="false">🕊️ Diplomat</button>
        <button type="button" class="role-btn" data-role="ranger" aria-pressed="false">🌿 Ranger</button>
        <button type="button" class="role-btn" data-role="guardian" aria-pressed="false">🛡️ Guardian</button>
        <button type="button" class="role-btn" data-role="merchant" aria-pressed="false">📦 Merchant</button>
      </div>
      <button id="ability-btn" style="width:100%; margin-top:8px; background:#75c8ff;" disabled>Select a role first</button>
    </div>

    <div class="stat-card">
      <h3>Island Status</h3>
      <div class="game-param"><span>Day:</span> <span class="param-val" id="day-display">1</span></div>
      <div class="game-param"><span>Hour:</span> <span class="param-val" id="hour-display">0</span></div>
      <div class="game-param"><span>Clans:</span> <span class="param-val" id="clan-count">4</span></div>
      <div class="game-param"><span>Fauna:</span> <span class="param-val" id="wildlife-count">0</span></div>
    </div>

    <div class="stat-card">
      <h3>Sustainability &amp; Equity</h3>
      <div class="game-param"><span title="Average land/water health across all settlements.">Environmental Health:</span> <span class="param-val" id="eco-health-display">100%</span></div>
      <div class="bar-track"><div class="bar-fill" id="eco-health-bar" style="width:100%; background:#8ef29a;"></div></div>

      <div class="game-param" style="margin-top:6px;"><span title="How evenly resources are distributed across active clans.">Resource Equity:</span> <span class="param-val" id="equity-display">100%</span></div>
      <div class="bar-track"><div class="bar-fill" id="equity-bar" style="width:100%; background:#75c8ff;"></div></div>

      <div class="game-param" style="margin-top:6px;"><span>Total Aid Delivered:</span> <span class="param-val" id="aid-display">0</span></div>
      <div class="game-param"><span>Clans in Shortage:</span> <span class="param-val" id="shortage-display">0</span></div>
      <div class="game-param"><span>Invasive Outbreaks:</span> <span class="param-val" id="invasive-display">0</span></div>
    </div>

    <div class="stat-card">
      <h3>Actions</h3>
      <button id="add-clan-btn" style="width: 100%;">Establish New Settlement</button>
      <div style="display: flex; gap: 5px; margin-top: 5px;">
        <button id="pause-btn" style="flex: 1; background: #a85c5c; color: white;" aria-pressed="false">Pause</button>
        <button id="resume-btn" style="flex: 1; background: #5ca86c; color: white; display: none;" aria-pressed="true">Resume</button>
      </div>
      <div class="instructions">Keyboard shortcut: press Space to pause/resume.</div>
    </div>

    <div class="stat-card" id="defense-builder">
      <h3>Clan Defenses</h3>
      <label for="defense-clan-select">Settlement:
        <select id="defense-clan-select"></select>
      </label>
      <div class="game-param" style="margin-top:4px;"><span>Defense Level:</span> <span class="param-val" id="defense-level-display">0/100</span></div>
      <div class="bar-track"><div class="bar-fill" id="defense-bar" style="width:0%; background:#e67e22;"></div></div>
      <button id="reinforce-btn" style="margin-top: 8px; width: 100%;">🛡️ Reinforce Defenses</button>
      <button id="clear-invasive-btn" style="margin-top: 5px; width: 100%; background:#a855c7; color:white;">🧹 Clear Nearby Invasives</button>
      <div class="instructions">Defense reduces raid/wildlife losses, and helps clear invasive outbreaks.</div>
    </div>

    <div class="stat-card" id="trade-builder">
      <h3>Custom Trade Route</h3>
      <label for="trade-from">From:
        <select id="trade-from"></select>
      </label>
      <label for="trade-to">To:
        <select id="trade-to"></select>
      </label>
      <div style="display: flex; gap: 3px;">
        <div style="flex: 2;">
          <label for="trade-give-res">Supply:
            <select id="trade-give-res">
              <option value="wood">Wood 🪵</option>
              <option value="food">Food 🌾</option>
              <option value="water">Water 💧</option>
              <option value="minerals">Minerals 🪨</option>
            </select>
          </label>
        </div>
        <div style="flex: 1;">
          <label for="trade-give-qty">Qty: <input type="number" id="trade-give-qty" value="10" min="1" max="30"></label>
        </div>
      </div>
      <button id="draw-route-btn" style="margin-top: 8px; width: 100%;">Draw Route Path</button>
      <div class="instructions" id="path-instruction">Click "Draw Route Path", then click on map to add waypoints between clans.</div>
      <button id="finish-path-btn" style="margin-top: 5px; width: 100%; display: none; background: #5ca86c; color: white;">Finish Path &amp; Start Route</button>
    </div>

    <div id="log" role="log" aria-live="polite" aria-label="Event log">
        <div class="log-event">Game Started. Open "How to Play" if you need the rules!</div>
    </div>
  </div>
</div>

<script>
// --- Modal Logic ---
document.getElementById('instructions-toggle').addEventListener('click', () => {
  document.getElementById('instructions-modal').style.display = 'flex';
  isPaused = true; // Automatically pause game when reading rules
  updatePauseButtons();
});

document.getElementById('close-modal-btn').addEventListener('click', () => {
  document.getElementById('instructions-modal').style.display = 'none';
  isPaused = false; // Unpause when closing
  updatePauseButtons();
});

function updatePauseButtons() {
  document.getElementById('pause-btn').style.display = isPaused ? 'none' : 'block';
  document.getElementById('resume-btn').style.display = isPaused ? 'block' : 'none';
  document.getElementById('pause-btn').setAttribute('aria-pressed', isPaused);
  document.getElementById('resume-btn').setAttribute('aria-pressed', !isPaused);
}
// -------------------

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const TICK_RATE = 1000;
const BASE_CARAVAN_SPEED = 1.0;
const BASE_WILDLIFE_SPEED = 0.3;
const BASE_RAIDER_SPEED = 0.5;
let TRADE_CARAVAN_SPEED = BASE_CARAVAN_SPEED;
let WILDLIFE_SPEED = BASE_WILDLIFE_SPEED;
let RAIDER_SPEED = BASE_RAIDER_SPEED;
const COLLISION_RADIUS = 15;

const NAME_PREFIXES = ["Verdan", "Stonepeak", "River", "Plains", "Iron", "Sunken", "Whispering", "Shadow", "Amber", "Storm", "Frost", "Gale"];
const NAME_SUFFIXES = ["Vipers", "Sentinels", "Runners", "Walkers", "Guards", "Keepers", "Stalkers", "Hunters", "Bears", "Wolves", "Claws"];

const CLAN_COLORS = [
  '#e74c3c', '#3498db', '#2ecc71', '#f1c40f',
  '#9b59b6', '#e67e22', '#1abc9c', '#fd79a8',
  '#6c5ce7', '#00cec9'
];

const BIOMES = {
  WOODS: { name: 'Forest', mainSupply: 'wood', needs: { water: 0.15, food: 0.05, minerals: 0.02, wood: 0.01 } },
  PLAINS: { name: 'Plains', mainSupply: 'food', needs: { wood: 0.20, water: 0.10, minerals: 0.02, food: 0.01 } },
  RIVER: { name: 'River Basin', mainSupply: 'water', needs: { food: 0.15, wood: 0.08, minerals: 0.02, water: 0.01 } },
  MOUNTAINS: { name: 'Crags', mainSupply: 'minerals', needs: { food: 0.15, water: 0.15, wood: 0.10, minerals: 0.01 } }
};

const ZONES = [
  { name: 'forest',    cx: 210, cy: 160, r: 260, color: 'rgba(30,90,35,0.30)' },
  { name: 'plains',    cx: 490, cy: 190, r: 260, color: 'rgba(190,175,80,0.24)' },
  { name: 'river',     cx: 280, cy: 420, r: 260, color: 'rgba(50,140,155,0.26)' },
  { name: 'mountains', cx: 520, cy: 410, r: 260, color: 'rgba(120,108,100,0.26)' }
];

const FAUNA = {
  tree:     { passive: 'deer',  aggressive: 'wolf' },
  mountain: { passive: 'goat',  aggressive: 'bear' },
  grass:    { passive: 'sheep', aggressive: 'boar' },
  reed:     { passive: 'otter', aggressive: 'croc' }
};
const FAUNA_STYLE = {
  wolf:  { color: '#9a9a9a' }, bear:  { color: '#63412c' },
  boar:  { color: '#8a5a35' }, croc:  { color: '#4d6b3a' },
  deer:  { color: '#c9a066' }, goat:  { color: '#eaeaea' },
  sheep: { color: '#f5f0e6' }, otter: { color: '#6b4a33' }
};

const ROLES = {
  diplomat: {
    name: 'Diplomat',
    desc: 'Trade specialist: caravans move 40% faster. Ability: Broker Peace calms raiders for a while.',
    ability: { name: 'Broker Peace', cooldown: 48, effect: activateBrokerPeace }
  },
  ranger: {
    name: 'Ranger',
    desc: 'Land specialist: environment regrows 2x faster and invasive species spread more slowly. Ability: Rapid Regrowth restores land island-wide.',
    ability: { name: 'Rapid Regrowth', cooldown: 48, effect: activateRapidRegrowth }
  },
  guardian: {
    name: 'Guardian',
    desc: 'Defense specialist: fortifications cost 40% less and raids are easier to repel. Ability: Rally Defenses reinforces every settlement.',
    ability: { name: 'Rally Defenses', cooldown: 48, effect: activateRallyDefenses }
  },
  merchant: {
    name: 'Merchant',
    desc: 'Logistics specialist: deliveries arrive 50% larger. Ability: Market Rush sends emergency supplies to whoever needs them most.',
    ability: { name: 'Market Rush', cooldown: 48, effect: activateMarketRush }
  }
};

const SHORTAGE_THRESHOLD = 10;
const OVERHARVEST_WARN = 30;

let isPaused = true; // Starts paused due to modal
let gameTimeH = 0;
let placingClan = false;
let drawingRoute = false;
let currentPathWaypoints = [];
let reducedMotion = false;
let currentRole = null;
let abilityCooldown = 0;
let raidSuppressionTimer = 0;

let terrainFeatures = [];
let islandPath = [];

let clans = [];
let tradeRoutes = [];
let caravans = [];
let wildlife = [];
let raiders = [];
let invasives = [];
let totalAidDelivered = 0;

function init() {
  generateOrganicIslandShape();
  generateTerrain();

  clans = [
    createClan(generateRandomName(), 210, 160, BIOMES.WOODS, CLAN_COLORS[0]),
    createClan(generateRandomName(), 490, 190, BIOMES.PLAINS, CLAN_COLORS[1]),
    createClan(generateRandomName(), 280, 420, BIOMES.RIVER, CLAN_COLORS[2]),
    createClan(generateRandomName(), 520, 410, BIOMES.MOUNTAINS, CLAN_COLORS[3])
  ];

  updateUIDropdowns();
  updateAbilityButton();
  updateUIStats();
  updatePauseButtons();

  setInterval(gameTick, TICK_RATE);
  requestAnimationFrame(animationLoop);
}

function createClan(name, x, y, biome, color) {
  return {
    id: Math.random().toString(36).substr(2, 9),
    name: name, x: x, y: y, biome: biome, color: color,
    population: 20,
    stock: { wood: 40, food: 40, water: 40, minerals: 15 },
    productionCooldown: 0,
    localEnvironment: 100,
    defense: 0,
    aidReceived: 0
  };
}

function generateRandomName() {
  return `${NAME_PREFIXES[Math.floor(Math.random() * NAME_PREFIXES.length)]} ${NAME_SUFFIXES[Math.floor(Math.random() * NAME_SUFFIXES.length)]}`;
}

function getCaravanRoleMult() { return currentRole === 'diplomat' ? 1.4 : 1; }
function getEnvRegenMult() { return currentRole === 'ranger' ? 2.0 : 1; }
function getInvasiveSpreadMult() { return currentRole === 'ranger' ? 0.5 : 1; }
function getDefenseCostMult() { return currentRole === 'guardian' ? 0.6 : 1; }
function getRaidResistBonus() { return currentRole === 'guardian' ? 0.15 : 0; }
function getQtyMult() { return currentRole === 'merchant' ? 1.5 : 1; }

function gameTick() {
  if (abilityCooldown > 0) abilityCooldown--;
  if (raidSuppressionTimer > 0) raidSuppressionTimer--;
  updateAbilityButton();

  if (isPaused || gameTimeH >= 30 * 24) return;
  gameTimeH++;

  let aClanDied = false;

  clans.forEach(clan => {
    if (clan.population <= 0) return;

    for (let res in clan.biome.needs) {
      clan.stock[res] -= clan.biome.needs[res] * (clan.population / 20);
      if (clan.stock[res] < 0) {
        clan.stock[res] = 0;
        if (Math.random() < 0.1) {
           clan.population--;
           log(`${clan.name} villager died of starvation (${res}).`, 'log-attack');
           if (clan.population <= 0) aClanDied = true;
        }
      }
    }

    clan.localEnvironment = Math.min(100, clan.localEnvironment + 0.08 * getEnvRegenMult());

    clan.productionCooldown--;
    if (clan.productionCooldown <= 0) {
        const overharvesting = clan.localEnvironment < OVERHARVEST_WARN;
        const yieldAmount = overharvesting ? 1 : 2;
        clan.stock[clan.biome.mainSupply] += yieldAmount;
        clan.localEnvironment = Math.max(0, clan.localEnvironment - 1.4);
        if (overharvesting && Math.random() < 0.15) {
          log(`${clan.name}'s ${clan.biome.mainSupply} supply is being overharvested — yields are dropping.`, 'log-eco');
        }
        clan.productionCooldown = 4;
    }
  });

  if (aClanDied) updateUIDropdowns();

  updateInvasives();
  if (gameTimeH > 5 * 24 && invasives.length < 10 && Math.random() < 0.012) spawnInvasive();

  const envHealth = computeEnvironmentalHealth();
  const habitatStressBonus = (100 - envHealth) / 1800;

  const passiveChance = 0.05 + (clans.length * 0.006);
  const aggressiveChance = 0.014 + habitatStressBonus;
  if (wildlife.length < 45 && Math.random() < passiveChance) spawnWildlife('passive');
  if (wildlife.length < 45 && Math.random() < aggressiveChance) spawnWildlife('aggressive');

  if (gameTimeH > 48 && raidSuppressionTimer <= 0 && Math.random() < 0.03) spawnRaiders();

  tradeRoutes.forEach(route => {
    const origin = route.from;
    const existingGroup = caravans.filter(c => c.routeId === route.id && c.state === 'delivering');

    if (existingGroup.length === 0 && origin.population > 0 && origin.stock[route.giveRes] >= route.giveQty) {
        origin.stock[route.giveRes] -= route.giveQty;

        const traderCount = 3;
        const totalQty = route.giveQty * getQtyMult();
        const qtyPerTrader = Math.ceil(totalQty / traderCount);

        for (let i = 0; i < traderCount; i++) {
            caravans.push({
                id: Math.random().toString(36).substr(2, 5),
                routeId: route.id,
                routePath: route.path,
                from: route.from,
                to: route.to,
                res: route.giveRes,
                qty: qtyPerTrader,
                pathIndex: 0,
                x: route.path[0].x,
                y: route.path[0].y,
                delay: i * 15,
                state: 'delivering'
            });
        }
        log(`${origin.name} dispatched traders to ${route.to.name}.`, 'log-trade');
    }
  });

  updateUIStats();
}

function computeEnvironmentalHealth() {
  const active = clans.filter(c => c.population > 0);
  if (active.length === 0) return 100;
  const sum = active.reduce((acc, c) => acc + c.localEnvironment, 0);
  return sum / active.length;
}

function computeEquityIndex() {
  const active = clans.filter(c => c.population > 0);
  if (active.length <= 1) return 100;
  const resources = ['wood', 'food', 'water', 'minerals'];
  let cvSum = 0;
  resources.forEach(res => {
    const values = active.map(c => c.stock[res]);
    const mean = values.reduce((a, b) => a + b, 0) / values.length;
    if (mean <= 0.0001) return;
    const variance = values.reduce((a, v) => a + Math.pow(v - mean, 2), 0) / values.length;
    const cv = Math.sqrt(variance) / mean;
    cvSum += cv;
  });
  const avgCv = cvSum / resources.length;
  return Math.max(0, Math.min(100, 100 - avgCv * 45));
}

function countShortages() {
  const active = clans.filter(c => c.population > 0);
  return active.filter(c => Object.values(c.stock).some(v => v < SHORTAGE_THRESHOLD)).length;
}

function spawnWildlife(behavior) {
    const spawns = terrainFeatures.filter(f => FAUNA[f.type]);
    if (spawns.length === 0) return;
    const feature = spawns[Math.floor(Math.random() * spawns.length)];
    const species = FAUNA[feature.type][behavior];

    wildlife.push({
        type: species,
        behavior: behavior,
        x: feature.x + (Math.random()*40-20),
        y: feature.y + (Math.random()*40-20),
        vx: (Math.random() - 0.5) * WILDLIFE_SPEED * 2,
        vy: (Math.random() - 0.5) * WILDLIFE_SPEED * 2,
        cooldown: 0
    });
}

function spawnRaiders() {
    const edge = Math.random() < 0.5;
    const x = edge ? (Math.random() < 0.5 ? 20 : canvas.width - 20) : Math.random() * canvas.width;
    const y = !edge ? (Math.random() < 0.5 ? 20 : canvas.height - 20) : Math.random() * canvas.height;

    const targets = clans.filter(c => c.population > 0);
    if (targets.length === 0) return;

    raiders.push({
        x: x, y: y,
        target: targets[Math.floor(Math.random() * targets.length)],
        size: 5 + Math.floor(Math.random()*5)
    });
}

function spawnInvasive(nearX, nearY) {
  let x, y, tries = 0;
  if (nearX !== undefined) {
    do {
      const ang = Math.random() * Math.PI * 2;
      const dist = 40 + Math.random() * 45;
      x = nearX + Math.cos(ang) * dist;
      y = nearY + Math.sin(ang) * dist;
      tries++;
    } while (!isPointInIsland(x, y) && tries < 20);
  } else {
    do {
      x = Math.random() * canvas.width;
      y = Math.random() * canvas.height;
      tries++;
    } while (!isPointInIsland(x, y) && tries < 30);
  }
  if (!isPointInIsland(x, y)) return;
  invasives.push({ id: Math.random().toString(36).substr(2, 6), x, y, radius: 10 });
  if (nearX === undefined) log('An invasive species has taken root on the island!', 'log-attack');
}

function updateInvasives() {
  for (let i = invasives.length - 1; i >= 0; i--) {
    const iv = invasives[i];
    iv.radius = Math.min(55, iv.radius + 0.06);

    clans.forEach(clan => {
      if (clan.population <= 0) return;
      const d = Math.hypot(clan.x - iv.x, clan.y - iv.y);
      if (d < 150) {
        const mitigation = 1 - Math.min(0.75, clan.defense / 160);
        clan.localEnvironment = Math.max(0, clan.localEnvironment - 0.25 * mitigation);
      }
    });

    if (invasives.length < 14 && Math.random() < 0.006 * getInvasiveSpreadMult()) {
      spawnInvasive(iv.x, iv.y);
    }
  }
}

function reinforceDefenses() {
  const clan = clans.find(c => c.id === document.getElementById('defense-clan-select').value);
  if (!clan || clan.population <= 0) { log('Select an active settlement first.'); return; }
  const mult = getDefenseCostMult();
  const cost = { wood: Math.round(15 * mult), minerals: Math.round(10 * mult) };
  if (clan.stock.wood < cost.wood || clan.stock.minerals < cost.minerals) {
    log(`${clan.name} lacks resources to reinforce defenses.`);
    return;
  }
  clan.stock.wood -= cost.wood;
  clan.stock.minerals -= cost.minerals;
  clan.defense = Math.min(100, clan.defense + 15);
  log(`${clan.name} reinforced defenses (now ${Math.round(clan.defense)}/100).`, 'log-trade');
  updateDefenseUI();
  updateUIStats();
}

function clearInvasives() {
  const clan = clans.find(c => c.id === document.getElementById('defense-clan-select').value);
  if (!clan || clan.population <= 0) { log('Select an active settlement first.'); return; }
  const cost = { wood: 10, minerals: 5 };
  if (clan.stock.wood < cost.wood || clan.stock.minerals < cost.minerals) {
    log(`${clan.name} lacks resources to send a clearing party.`);
    return;
  }
  const nearby = invasives.filter(iv => Math.hypot(iv.x - clan.x, iv.y - clan.y) < 160);
  if (nearby.length === 0) {
    log(`${clan.name} found no invasive growth nearby.`, 'log-eco');
    return;
  }
  clan.stock.wood -= cost.wood;
  clan.stock.minerals -= cost.minerals;
  const successChance = 0.35 + clan.defense * 0.006;
  if (Math.random() < successChance) {
    const target = nearby[0];
    invasives.splice(invasives.indexOf(target), 1);
    log(`${clan.name}'s clearing party removed an invasive outbreak!`, 'log-eco');
  } else {
    log(`${clan.name}'s clearing party failed to fully clear the invasive growth.`, 'log-attack');
  }
  updateUIStats();
}

function activateBrokerPeace() {
  raidSuppressionTimer = 30;
  log('Diplomatic outreach calms nearby raiders.', 'log-eco');
}
function activateRapidRegrowth() {
  clans.forEach(c => { if (c.population > 0) c.localEnvironment = Math.min(100, c.localEnvironment + 25); });
  log('Rapid regrowth restores land across the island.', 'log-eco');
}
function activateRallyDefenses() {
  clans.forEach(c => { if (c.population > 0) c.defense = Math.min(100, c.defense + 10); });
  log('Every settlement reinforces its defenses.', 'log-eco');
  updateDefenseUI();
}
function activateMarketRush() {
  const active = clans.filter(c => c.population > 0);
  if (active.length === 0) return;
  let target = active[0], lowest = Infinity;
  active.forEach(c => {
    const total = Object.values(c.stock).reduce((a, b) => a + b, 0);
    if (total < lowest) { lowest = total; target = c; }
  });
  ['wood', 'food', 'water', 'minerals'].forEach(r => target.stock[r] += 15);
  log(`Market Rush delivers emergency supplies to ${target.name}.`, 'log-trade');
}

function useAbility() {
  if (!currentRole || abilityCooldown > 0) return;
  ROLES[currentRole].ability.effect();
  abilityCooldown = ROLES[currentRole].ability.cooldown;
  updateAbilityButton();
  updateUIStats();
}

function updateAbilityButton() {
  const btn = document.getElementById('ability-btn');
  if (!currentRole) { btn.disabled = true; btn.innerText = 'Select a role first'; return; }
  const role = ROLES[currentRole];
  if (abilityCooldown > 0) {
    btn.disabled = true;
    btn.innerText = `${role.ability.name} (ready in ${abilityCooldown}h)`;
  } else {
    btn.disabled = false;
    btn.innerText = `Use Ability: ${role.ability.name}`;
  }
}

function animationLoop() {
  if (!isPaused) {
    moveCaravans();
    moveWildlife();
    moveRaiders();
    handleCollisions();
  }

  drawGraphics();
  requestAnimationFrame(animationLoop);
}

function moveCaravans() {
    const speed = TRADE_CARAVAN_SPEED * getCaravanRoleMult();
    caravans.forEach((caravan, index) => {
        if (caravan.delay > 0) {
            caravan.delay--;
            return;
        }

        const path = caravan.state === 'delivering' ? caravan.routePath : [...caravan.routePath].reverse();
        const targetPoint = path[caravan.pathIndex];

        if (!targetPoint) return;

        const dx = targetPoint.x - caravan.x;
        const dy = targetPoint.y - caravan.y;
        const dist = Math.hypot(dx, dy);

        if (dist > 3) {
            caravan.x += (dx / dist) * speed;
            caravan.y += (dy / dist) * speed;
        } else {
            if (caravan.pathIndex < path.length - 1) {
                caravan.pathIndex++;
            } else {
                if (caravan.state === 'delivering') {
                    if (caravan.to.population > 0) {
                       caravan.to.stock[caravan.res] += caravan.qty;
                       caravan.to.aidReceived += caravan.qty;
                       totalAidDelivered += caravan.qty;
                       log(`Trader arrived at ${caravan.to.name} (+${caravan.qty} ${caravan.res}).`, 'log-trade');
                    }
                    caravan.state = 'returning';
                    caravan.pathIndex = 0;
                } else {
                    caravans.splice(index, 1);
                }
            }
        }
    });
}

function moveWildlife() {
    wildlife.forEach(w => {
        w.x += w.vx; w.y += w.vy;
        if (!isPointInIsland(w.x, w.y)) {
            w.vx *= -1; w.vy *= -1;
            w.x += w.vx * 2; w.y += w.vy * 2;
        }
        if (Math.random() < 0.01) {
            w.vx = (Math.random() - 0.5) * WILDLIFE_SPEED * 2;
            w.vy = (Math.random() - 0.5) * WILDLIFE_SPEED * 2;
        }
        w.cooldown = Math.max(0, w.cooldown - 1);
    });
}

function moveRaiders() {
    raiders.forEach((r, index) => {
        const dx = r.target.x - r.x;
        const dy = r.target.y - r.y;
        const dist = Math.hypot(dx, dy);

        if (dist > COLLISION_RADIUS) {
            r.x += (dx / dist) * RAIDER_SPEED;
            r.y += (dy / dist) * RAIDER_SPEED;
        } else {
            resolveSettlementRaid(r.target, r.size);
            raiders.splice(index, 1);
        }
    });
}

function handleCollisions() {
    wildlife.forEach(w => {
        if (w.cooldown > 0) return;
        if (w.behavior === 'aggressive') {
            caravans.forEach((c, cIndex) => {
                if (Math.hypot(w.x - c.x, w.y - c.y) < COLLISION_RADIUS) {
                    log(`Wildlife (${w.type}) attacked a trader!`, 'log-attack');
                    if (Math.random() < 0.45) {
                        log(`Trader defeated. ${c.qty} ${c.res} dropped.`, 'log-attack');
                        caravans.splice(cIndex, 1);
                    }
                    w.cooldown = 200;
                }
            });
        } else {
            caravans.forEach(c => {
                if (Math.hypot(w.x - c.x, w.y - c.y) < COLLISION_RADIUS && Math.random() < 0.05) {
                    c.delay += 20;
                    w.cooldown = 150;
                }
            });
        }
    });
}

function resolveSettlementRaid(clan, size) {
    if (clan.population <= 0) return;
    const defenseMitigation = (clan.defense / 100) * 0.6 + getRaidResistBonus();
    const impact = Math.max(1, Math.round(size * (1 - defenseMitigation)));
    clan.population = Math.max(0, clan.population - impact);
    ['wood', 'food', 'water', 'minerals'].forEach(res => {
        clan.stock[res] = Math.max(0, clan.stock[res] - Math.round(impact * 1.5));
    });
    log(`Raiders attacked ${clan.name}! Population dropped by ${impact}.`, 'log-attack');
    updateUIDropdowns();
}

function generateOrganicIslandShape() {
    islandPath = [];
    const cx = 400, cy = 300, baseR = 230;
    for (let angle = 0; angle < Math.PI * 2; angle += 0.1) {
        const noise = Math.sin(angle * 5) * 18 + Math.cos(angle * 3) * 12;
        const r = baseR + noise;
        islandPath.push({ x: cx + Math.cos(angle) * r, y: cy + Math.sin(angle) * (r * 0.72) });
    }
}

function isPointInIsland(x, y) {
    let inside = false;
    for (let i = 0, j = islandPath.length - 1; i < islandPath.length; j = i++) {
        const xi = islandPath[i].x, yi = islandPath[i].y;
        const xj = islandPath[j].x, yj = islandPath[j].y;
        const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi);
        if (intersect) inside = !inside;
    }
    return inside;
}

function generateTerrain() {
    terrainFeatures = [];
    ZONES.forEach(zone => {
        for (let i = 0; i < 6; i++) {
            const ang = Math.random() * Math.PI * 2;
            const dist = Math.random() * (zone.r * 0.65);
            const x = zone.cx + Math.cos(ang) * dist;
            const y = zone.cy + Math.sin(ang) * (dist * 0.75);
            if (isPointInIsland(x, y)) {
                let type = 'tree';
                if (zone.name === 'mountains') type = 'mountain';
                else if (zone.name === 'plains') type = 'grass';
                else if (zone.name === 'river') type = 'reed';
                terrainFeatures.push({ type, x, y });
            }
        }
    });
}

function drawGraphics() {
    ctx.fillStyle = '#1d4361';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    if (!reducedMotion) {
        ctx.strokeStyle = '#245275';
        ctx.lineWidth = 1;
        const t = Date.now() * 0.001;
        for (let i = 0; i < canvas.width; i += 40) {
            ctx.beginPath();
            ctx.moveTo(i + Math.sin(t + i)*5, 0);
            ctx.lineTo(i + Math.sin(t + i)*5, canvas.height);
            ctx.stroke();
        }
    }

    ctx.fillStyle = '#c2a66e';
    ctx.beginPath();
    islandPath.forEach((p, idx) => idx === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y));
    ctx.closePath();
    ctx.fill();
    ctx.lineWidth = 6;
    ctx.strokeStyle = '#9e814d';
    ctx.stroke();

    ctx.fillStyle = '#4a7c59';
    ctx.beginPath();
    islandPath.forEach((p, idx) => idx === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y));
    ctx.closePath();
    ctx.fill();

    ZONES.forEach(z => {
        ctx.fillStyle = z.color;
        ctx.beginPath();
        ctx.arc(z.cx, z.cy, z.r * 0.55, 0, Math.PI * 2);
        ctx.fill();
    });

    terrainFeatures.forEach(f => {
        ctx.fillStyle = f.type === 'tree' ? '#2e5a36' : f.type === 'mountain' ? '#70655a' : f.type === 'grass' ? '#80a86b' : '#397864';
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.type === 'mountain' ? 7 : 5, 0, Math.PI * 2);
        ctx.fill();
    });

    invasives.forEach(iv => {
        ctx.fillStyle = 'rgba(168, 85, 199, 0.35)';
        ctx.beginPath();
        ctx.arc(iv.x, iv.y, iv.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#a855c7';
        ctx.lineWidth = 1.5;
        ctx.stroke();
    });

    tradeRoutes.forEach(route => {
        if (!route.path || route.path.length < 2) return;
        ctx.strokeStyle = '#75c8ff';
        ctx.lineWidth = 2.5;
        ctx.setLineDash([6, 6]);
        ctx.beginPath();
        route.path.forEach((pt, idx) => idx === 0 ? ctx.moveTo(pt.x, pt.y) : ctx.lineTo(pt.x, pt.y));
        ctx.stroke();
        ctx.setLineDash([]);
    });

    caravans.forEach(c => {
        ctx.fillStyle = '#ffd983';
        ctx.beginPath();
        ctx.arc(c.x, c.y, 4, 0, Math.PI * 2);
        ctx.fill();
    });

    wildlife.forEach(w => {
        ctx.fillStyle = FAUNA_STYLE[w.type] ? FAUNA_STYLE[w.type].color : '#fff';
        ctx.beginPath();
        ctx.arc(w.x, w.y, w.behavior === 'aggressive' ? 4.5 : 3, 0, Math.PI * 2);
        ctx.fill();
    });

    raiders.forEach(r => {
        ctx.fillStyle = '#ff5555';
        ctx.beginPath();
        ctx.arc(r.x, r.y, 6, 0, Math.PI * 2);
        ctx.fill();
    });

    clans.forEach(clan => {
        if (clan.population <= 0) return;
        ctx.fillStyle = clan.color;
        ctx.beginPath();
        ctx.arc(clan.x, clan.y, 14, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 2;
        ctx.stroke();

        if (clan.defense > 0) {
            ctx.strokeStyle = '#e67e22';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(clan.x, clan.y, 18, 0, Math.PI * 2 * (clan.defense / 100));
            ctx.stroke();
        }

        ctx.fillStyle = '#fff';
        ctx.font = 'bold 11px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(`${clan.name} (${clan.population})`, clan.x, clan.y - 20);
    });

    if (drawingRoute && currentPathWaypoints.length > 0) {
        ctx.strokeStyle = '#ffd983';
        ctx.lineWidth = 2;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        currentPathWaypoints.forEach((pt, idx) => idx === 0 ? ctx.moveTo(pt.x, pt.y) : ctx.lineTo(pt.x, pt.y));
        ctx.stroke();
        ctx.setLineDash([]);
    }
}

function updateUIStats() {
    document.getElementById('day-display').innerText = Math.floor(gameTimeH / 24) + 1;
    document.getElementById('hour-display').innerText = gameTimeH % 24;
    document.getElementById('clan-count').innerText = clans.filter(c => c.population > 0).length;
    document.getElementById('wildlife-count').innerText = wildlife.length;

    const envHealth = Math.round(computeEnvironmentalHealth());
    document.getElementById('eco-health-display').innerText = envHealth + '%';
    document.getElementById('eco-health-bar').style.width = envHealth + '%';

    const equity = Math.round(computeEquityIndex());
    document.getElementById('equity-display').innerText = equity + '%';
    document.getElementById('equity-bar').style.width = equity + '%';

    document.getElementById('aid-display').innerText = totalAidDelivered;
    document.getElementById('shortage-display').innerText = countShortages();
    document.getElementById('invasive-display').innerText = invasives.length;
}

function updateDefenseUI() {
    const clanId = document.getElementById('defense-clan-select').value;
    const clan = clans.find(c => c.id === clanId);
    if (!clan) return;
    const def = Math.round(clan.defense);
    document.getElementById('defense-level-display').innerText = def + '/100';
    document.getElementById('defense-bar').style.width = def + '%';
}

function updateUIDropdowns() {
    const active = clans.filter(c => c.population > 0);
    const fromSelect = document.getElementById('trade-from');
    const toSelect = document.getElementById('trade-to');
    const defSelect = document.getElementById('defense-clan-select');

    fromSelect.innerHTML = '';
    toSelect.innerHTML = '';
    defSelect.innerHTML = '';

    active.forEach(c => {
        fromSelect.add(new Option(c.name, c.id));
        toSelect.add(new Option(c.name, c.id));
        defSelect.add(new Option(c.name, c.id));
    });

    updateDefenseUI();
}

function log(msg, type='log-event') {
    const logBox = document.getElementById('log');
    const div = document.createElement('div');
    div.className = type;
    div.innerText = `[Hour ${gameTimeH}] ${msg}`;
    logBox.prepend(div);
}

canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    if (placingClan) {
        if (!isPointInIsland(x, y)) {
            log('Settlement must be placed on the island landmass.');
            return;
        }
        const biomeKeys = Object.keys(BIOMES);
        const randomBiome = BIOMES[biomeKeys[Math.floor(Math.random() * biomeKeys.length)]];
        const color = CLAN_COLORS[clans.length % CLAN_COLORS.length];
        const newClan = createClan(generateRandomName(), x, y, randomBiome, color);
        clans.push(newClan);
        placingClan = false;
        document.getElementById('add-clan-btn').innerText = 'Establish New Settlement';
        updateUIDropdowns();
        log(`New settlement established: ${newClan.name}.`, 'log-eco');
        return;
    }

    if (drawingRoute) {
        currentPathWaypoints.push({ x, y });
        log(`Waypoint added at (${Math.round(x)}, ${Math.round(y)}).`, 'log-trade');
    }
});

document.getElementById('add-clan-btn').addEventListener('click', () => {
    placingClan = !placingClan;
    document.getElementById('add-clan-btn').innerText = placingClan ? 'Click on map to place settlement...' : 'Establish New Settlement';
});

document.getElementById('draw-route-btn').addEventListener('click', () => {
    const fromId = document.getElementById('trade-from').value;
    const toId = document.getElementById('trade-to').value;
    if (fromId === toId) { log('Origin and destination must be different settlements.'); return; }

    drawingRoute = true;
    const fromClan = clans.find(c => c.id === fromId);
    currentPathWaypoints = [{ x: fromClan.x, y: fromClan.y }];
    document.getElementById('draw-route-btn').style.display = 'none';
    document.getElementById('finish-path-btn').style.display = 'block';
    document.getElementById('path-instruction').innerText = 'Click on the map to add intermediate waypoints, then click Finish Path.';
    log('Started drawing custom trade route path.', 'log-trade');
});

document.getElementById('finish-path-btn').addEventListener('click', () => {
    const fromId = document.getElementById('trade-from').value;
    const toId = document.getElementById('trade-to').value;
    const toClan = clans.find(c => c.id === toId);

    if (currentPathWaypoints.length < 2) {
        currentPathWaypoints.push({ x: toClan.x, y: toClan.y });
    } else {
        currentPathWaypoints[currentPathWaypoints.length - 1] = { x: toClan.x, y: toClan.y };
    }

    const giveRes = document.getElementById('trade-give-res').value;
    const giveQty = parseInt(document.getElementById('trade-give-qty').value) || 10;

    tradeRoutes.push({
        id: Math.random().toString(36).substr(2, 6),
        from: clans.find(c => c.id === fromId),
        to: toClan,
        giveRes: giveRes,
        giveQty: giveQty,
        path: [...currentPathWaypoints]
    });

    drawingRoute = false;
    currentPathWaypoints = [];
    document.getElementById('draw-route-btn').style.display = 'block';
    document.getElementById('finish-path-btn').style.display = 'none';
    document.getElementById('path-instruction').innerText = 'Click "Draw Route Path", then click on map to add waypoints between clans.';
    log('Trade route finalized and activated.', 'log-trade');
});

document.getElementById('pause-btn').addEventListener('click', () => {
    isPaused = true;
    updatePauseButtons();
    log('Simulation paused.');
});
document.getElementById('resume-btn').addEventListener('click', () => {
    isPaused = false;
    updatePauseButtons();
    log('Simulation resumed.');
});

window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && e.target.tagName !== 'INPUT' && e.target.tagName !== 'SELECT' && e.target.tagName !== 'TEXTAREA') {
        e.preventDefault();
        isPaused = !isPaused;
        updatePauseButtons();
        log(isPaused ? 'Simulation paused.' : 'Simulation resumed.');
    }
});

document.querySelectorAll('.role-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.role-btn').forEach(b => {
            b.setAttribute('aria-pressed', 'false');
            b.style.background = '#4a3b32';
        });
        btn.setAttribute('aria-pressed', 'true');
        btn.style.background = '#75c8ff';
        currentRole = btn.getAttribute('data-role');
        document.getElementById('role-desc').innerText = ROLES[currentRole].desc;
        updateAbilityButton();
        log(`Role selected: ${ROLES[currentRole].name}.`, 'log-eco');
    });
});

document.getElementById('ability-btn').addEventListener('click', useAbility);
document.getElementById('reinforce-btn').addEventListener('click', reinforceDefenses);
document.getElementById('clear-invasive-btn').addEventListener('click', clearInvasives);
document.getElementById('defense-clan-select').addEventListener('change', updateDefenseUI);

document.getElementById('contrast-toggle').addEventListener('click', () => {
    document.body.classList.toggle('high-contrast');
    const active = document.body.classList.contains('high-contrast');
    document.getElementById('contrast-toggle').setAttribute('aria-pressed', active);
});

document.getElementById('motion-toggle').addEventListener('click', () => {
    reducedMotion = !reducedMotion;
    document.getElementById('motion-toggle').setAttribute('aria-pressed', reducedMotion);
    log(reducedMotion ? 'Reduced motion enabled.' : 'Standard motion enabled.');
});

window.onload = init;
</script>
</body>
</html>
